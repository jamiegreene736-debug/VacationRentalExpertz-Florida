# Booking Engine API keys from Guesty Growth → Distribution → Booking Engine API.
# Open API keys will not work here.
GUESTY_CLIENT_ID=
GUESTY_CLIENT_SECRET=

# Static HTTPS root for the Florida Guesty Booking Engine.
# Example: https://your-florida-subdomain.guestybookings.com
GUESTY_BOOKING_ENGINE_URL=

# Optional: only expose listings carrying this Guesty tag.
GUESTY_LISTING_TAG=

# Optional extra filter. Leave empty to show every listing assigned to this Booking Engine.
GUESTY_CONDO_TAG=

# Optional directory for the reused Guesty token and listing snapshot.
# Production should use a persistent volume such as /data.
GUESTY_CACHE_DIR=

# Public canonical origin used for social metadata after launch.
SITE_URL=
