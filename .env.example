# Create an API application in Guesty under Integrations > API & Webhooks.
GUESTY_CLIENT_ID=
GUESTY_CLIENT_SECRET=

# Full HTTPS URL for the Florida Guesty Booking Engine.
GUESTY_BOOKING_ENGINE_URL=

# Optional: only expose listings carrying this Guesty tag.
GUESTY_LISTING_TAG=

# Condo-only guard: propertyType must contain "condo" or this exact tag (default: condo).
GUESTY_CONDO_TAG=condo

# Public canonical origin used for social metadata after launch.
SITE_URL=
